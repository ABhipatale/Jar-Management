APP_NAME="Jar Management"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.your-domain.com
APP_TIMEZONE=Asia/Kolkata

# Vercel URL(s) of the React app, comma-separated
FRONTEND_URL=https://your-app.vercel.app,http://localhost:5173

# The platform owner (super admin) who registers and manages companies.
# Created by: php artisan db:seed (only if missing; a password changed later is kept).
SUPERADMIN_NAME="Super Admin"
SUPERADMIN_EMAIL=you@example.com
SUPERADMIN_PASSWORD=

# Your product's name, shown on the login page and the super-admin panel
# (each company's own name/logo is set in the app).
PLATFORM_NAME="Jar Management"
PLATFORM_NAME_MR="जार व्यवस्थापन"

# Plan payments (Razorpay subscriptions, auto-renewing). Leave empty until you have keys:
# companies still see the plans, and the super admin extends plans by hand.
# Webhook: in the Razorpay dashboard add https://<your-domain>/api/billing/webhook with events
# subscription.activated, subscription.charged, subscription.cancelled, subscription.halted,
# subscription.completed, and put its secret here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Phone notifications (Web Push) for jar reminders. Generate one key pair, e.g.:
#   node -e "const e=require('crypto').createECDH('prime256v1');e.generateKeys();const b=x=>x.toString('base64url');console.log(b(e.getPublicKey()),b(e.getPrivateKey()))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

APP_LOCALE=mr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=your-mysql-host
DB_PORT=3306
DB_DATABASE=sai_water
DB_USERNAME=root
DB_PASSWORD=
# Or a single URL: DB_URL=mysql://user:pass@host:3306/sai_water
# If your host requires TLS, point this at a CA file (in the Vercel container: /etc/ssl/certs/ca-certificates.crt)
# MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
